{
  "name": "codex-quota-monitor",
  "version": "2.0.0-rc.2",
  "description": "GPT-白汐 / GPT-Shirotide — Codex quota desktop pet, task center and multi-provider usage ledger.",
  "main": "src/main.js",
  "author": "GPT-Shirotide",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "icons": "node scripts/build-icons.js",
    "prebuild": "npm run icons",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.codex.quota-monitor",
    "productName": "GPT-白汐",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/tray-icon-on-dark.png",
        "to": "tray-icon-on-dark.png"
      },
      {
        "from": "assets/tray-icon-on-light.png",
        "to": "tray-icon-on-light.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "gpt-shirotide-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GPT-白汐"
    },
    "portable": {
      "artifactName": "gpt-shirotide-${version}-portable-${arch}.${ext}"
    },
    "buildVersion": "2.0.0.102",
    "beforePack": "./scripts/filter-packaged-docs.cjs",
    "publish": {
      "provider": "github",
      "owner": "Nahida728",
      "repo": "gpt-quota-pet-Shirotide",
      "releaseType": "prerelease",
      "channel": "rc"
    }
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "sharp": "0.34.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "^3.1.2",
    "semver": "7.7.3"
  },
  "displayVersion": "2.0.0-rc.2",
  "homepage": "https://github.com/Nahida728/gpt-quota-pet-Shirotide",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nahida728/gpt-quota-pet-Shirotide.git"
  },
  "bugs": {
    "url": "https://github.com/Nahida728/gpt-quota-pet-Shirotide/issues"
  }
}
